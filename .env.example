NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional STON.fi referrer settings for grant/demo deployments.
NEXT_PUBLIC_STONFI_REFERRER_ADDRESS=
NEXT_PUBLIC_STONFI_REFERRER_FEE_BPS=

# Farcaster account association values are required for a production-valid
# /.well-known/farcaster.json manifest. You can either set the combined JSON
# object or the three individual fields.
FARCASTER_ACCOUNT_ASSOCIATION=
FARCASTER_ACCOUNT_ASSOCIATION_HEADER=
FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD=
FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE=
